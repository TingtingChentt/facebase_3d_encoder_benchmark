# ── generated point clouds ─────────────────────────────────────────────────
# The processed .npy facial point clouds are regenerated from the FaceBase
# source meshes by facebench/preprocessing/preprocess.py. Only the manifests
# (which define the splits) are tracked.
data/processed/ofc/
data/processed/syndrome/
data/processed/controls/
data/processed/ofc_icp*/
data/processed/syndrome_icp*/
data/raw/

# ── training outputs ───────────────────────────────────────────────────────
runs/
logs/

# ── cached encoder features (large; regenerated by extract_features.py) ────
results/features*/

# ── job lists (regenerated by facebench/eval/make_*_jobs.py; they embed
#    absolute paths for the machine they were generated on) ────────────────
facebench/eval/*joblist*.txt

# ── python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
