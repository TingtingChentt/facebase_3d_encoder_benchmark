# ── FaceBase-derived data: never committed ────────────────────────────────
# Point clouds regenerated from the FaceBase meshes by preprocess.py.
data/processed/
data/raw/
# Labelled manifests: built locally from the FaceBase metadata by
# facebench/preprocessing/build_manifests.py. Only ID + partition files
# (data/splits/) are shipped.
data/manifests/
data/labels/build/
# Exemplar subjects for the figures that render faces (local only).
data/exemplars.csv

# ── model outputs keyed by scan / subject (local only) ───────────────────
runs
results/features*
results/predictions
results/training/
results/interp/*
!results/interp/tables/
results/prioritization/A_per_patient_rank.csv.gz
results/prioritization/B_per_patient.csv.gz
results/fig1/

# ── job lists (regenerated by facebench/training/make_jobs.py) ───────────
facebench/training/*joblist*.txt
logs/

# ── python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.DS_Store
figures/src/
